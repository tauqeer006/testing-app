# Oracle Database and Application Environment Configuration
ORACLE_PASSWORD=OracleSecretPassword123!
APP_USER=APPUSER
APP_USER_PASSWORD=AppUserPassword123!
PORT=3000
EXPECTED_READ_DB=PRIMARY
BASE_URL=http://localhost:3000

# Currency Exchange Rates Providers Configuration
FRANKFURTER_URL=https://api.frankfurter.dev/v1/latest?base={BASE}
OPEN_ER_API_URL=https://open.er-api.com/v6/latest/{BASE}
CURRENCY_API_URL_PRIMARY=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/{base}.json
CURRENCY_API_URL_MIRROR=https://latest.currency-api.pages.dev/v1/currencies/{base}.json

# Mock providers toggle
USE_MOCK_PROVIDERS=false

# Cache and Supported Currencies
SUPPORTED_CURRENCIES=USD,EUR,GBP,JPY,INR,PKR
RATES_CACHE_TTL_SECONDS=600
RATES_STALE_MAX_SECONDS=3600
